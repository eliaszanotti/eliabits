{
    "compilerOptions": {
        "allowJs": true,
        "strict": true,
        "moduleResolution": "Bundler",
        "module": "ESNext",
        "target": "ES2022",
        "jsx": "react-jsx",
        "skipLibCheck": true,
        "types": ["node"],
        "noEmit": true
    },
    "include": ["./**/*"],
    "exclude": ["./_generated"]
}
